# Copy to .env.local and fill in. `bin/console pilot:bootstrap` writes the SCRIBASE_* values for you.
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost

###> scribase ###
SCRIBASE_API_BASE=https://api.scribase.com
SCRIBASE_API_KEY=
SCRIBASE_ORG=
SCRIBASE_PROJECT=
SCRIBASE_POLL_ATTEMPTS=40
SCRIBASE_POLL_INTERVAL=3
###< scribase ###

###> llm ###
# Which agent `pilot:review` uses: huggingface or ollama.
PILOT_PLATFORM=huggingface
# Hugging Face Inference Providers: a fine-grained token with "Make calls to Inference Providers".
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct
HUGGINGFACE_PROVIDER=
# Local, free fallback.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
###< llm ###
